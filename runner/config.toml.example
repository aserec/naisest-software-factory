# GitLab Runner config for the factory. Copy to /etc/gitlab-runner/config.toml.
# Replace the values in <angle brackets>.
# Plugin keys follow the README: https://gitlab.com/hetznercloud/fleeting-plugin-hetzner
# (docs/reference/configuration.md and docs/guides/quickstart.md).
concurrent = 4

[[runners]]
  name = "factory-hetzner"
  url = "https://gitlab.example.com"
  token = "<RUNNER_AUTH_TOKEN>"
  executor = "docker-autoscaler"

  [runners.docker]
    image = "node:22"
    privileged = false
    # No Docker socket volume. Jobs must never see the host Docker.
    volumes = ["/cache"]
    # The agent sandbox (bubblewrap) needs user namespaces, and Docker's default seccomp and AppArmor profiles block them.
    # This is safe only because each VM runs one job and is then deleted. Never copy it to a shared runner.
    security_opt = ["seccomp=unconfined", "apparmor=unconfined"]

  [runners.autoscaler]
    plugin = "hetznercloud/fleeting-plugin-hetzner:1.4.7"
    capacity_per_instance = 1   # one job per VM
    max_use_count = 1           # delete the VM after one job
    max_instances = 4
    # Wait for cloud-init (Docker install) before the VM takes a job.
    instance_ready_command = "cloud-init status --wait || test $? -eq 2"

    [runners.autoscaler.plugin_config]
      name = "factory-runner"
      token = "<HETZNER_API_TOKEN>"
      location = "fsn1"         # Falkenstein, Germany. "hel1" (Helsinki) also works.
      server_type = "ccx23"     # 4 dedicated vCPU, 16 GB RAM
      image = "ubuntu-24.04"
      user_data_file = "/etc/gitlab-runner/cloud-init.yml"

    [runners.autoscaler.connector_config]
      username = "root"
      use_external_addr = true

    [[runners.autoscaler.policy]]
      idle_count = 0
      idle_time = "0s"
