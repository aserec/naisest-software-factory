// Grafana Alloy on each runner VM. Ships job container logs, the journal and node metrics to ops.<domain>.
// runner/cloud-init.yml holds a copy of this file (factory/runner-config.test.ts checks they match).
// Replace the values in <angle brackets> in the runner host's copy of cloud-init.yml, never in git.
// Every line carries job="factory-runner" and host; logs also carry source (docker, gitlab-runner or system).

// Job container logs, from Docker's json-file logs.
local.file_match "docker" {
	path_targets = [{"__path__" = "/var/lib/docker/containers/*/*-json.log"}]
}

loki.source.file "docker" {
	targets    = local.file_match.docker.targets
	forward_to = [loki.process.docker.receiver]
}

loki.process "docker" {
	stage.docker { }

	stage.static_labels {
		values = {source = "docker"}
	}
	forward_to = [loki.write.ops.receiver]
}

// The journal: gitlab-runner's unit is source="gitlab-runner", the rest source="system".
loki.relabel "journal" {
	forward_to = []

	rule {
		target_label = "source"
		replacement  = "system"
	}

	rule {
		source_labels = ["__journal__systemd_unit"]
		regex         = "gitlab-runner\\.service"
		target_label  = "source"
		replacement   = "gitlab-runner"
	}
}

loki.source.journal "journal" {
	relabel_rules = loki.relabel.journal.rules
	forward_to    = [loki.write.ops.receiver]
}

loki.write "ops" {
	endpoint {
		url = "<LOKI_PUSH_URL>"

		basic_auth {
			username      = "<ALLOY_PUSH_USER>"
			password_file = "/etc/alloy/push-password"
		}
	}
	external_labels = {job = "factory-runner", host = constants.hostname}
}

// Disk, memory and CPU of the VM.
prometheus.exporter.unix "node" { }

prometheus.scrape "node" {
	targets         = prometheus.exporter.unix.node.targets
	forward_to      = [prometheus.relabel.runner.receiver]
	scrape_interval = "30s"
}

// The exporter sets its own job label, so set job and host here.
prometheus.relabel "runner" {
	forward_to = [prometheus.remote_write.ops.receiver]

	rule {
		target_label = "job"
		replacement  = "factory-runner"
	}

	rule {
		target_label = "host"
		replacement  = constants.hostname
	}
}

prometheus.remote_write "ops" {
	endpoint {
		url = "<METRICS_PUSH_URL>"

		basic_auth {
			username      = "<ALLOY_PUSH_USER>"
			password_file = "/etc/alloy/push-password"
		}
	}
}
