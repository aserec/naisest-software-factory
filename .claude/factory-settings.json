{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(rm *)",
      "Bash(pnpm run*)",
      "Bash(npm run*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git -c*)",
      "Bash(git -C*)",
      "Bash(glab*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "WebFetch",
      "WebSearch",
      "Read(//proc/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.config/**)",
      "Read(~/.ssh/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./.agents/**)",
      "Write(./.agents/**)",
      "Edit(./.git/**)",
      "Write(./.git/**)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "network": {
      "strictAllowlist": true,
      "allowUnixSockets": ["/tmp/claude", "/private/tmp/claude"]
    }
  }
}
