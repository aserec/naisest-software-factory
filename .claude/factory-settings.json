{
  "permissions": {
    "allow": [
      "Read", "Edit", "Write",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)",
      "Bash(pnpm lint*)", "Bash(pnpm test*)", "Bash(pnpm build*)"
    ],
    "deny": ["Bash(git push*)", "Bash(glab*)", "Bash(curl*)", "Bash(wget*)", "WebFetch", "WebSearch"]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "strictAllowlist": true,
    "network": {
      "allowedDomains": [
        "gitlab.example.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "registry-1.docker.io"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "[ -x .agents/hooks/deny-dangerous.sh ] && .agents/hooks/deny-dangerous.sh || true" }] }
    ]
  }
}
