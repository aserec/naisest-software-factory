# Copy to .env (git-ignored). local-factory.sh and local-run.sh read it: NAME=value, no quotes. A variable set in the shell wins.
# Model keys
TENSORX_API_KEY=
CELERIS_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Your own tokens: the tracker and code host of every target the bot cannot write to
GL_TOKEN=
FACTORY_GITHUB_TOKEN=
# The factory's own accounts (classic token with repo and project scopes on GitHub, api scope on GitLab).
# Used for each target where the account may push and, on GitHub, edit the project board.
FACTORY_BOT_GITHUB_TOKEN=
FACTORY_BOT_GITLAB_TOKEN=
# Optional: the author email of the bot's commits. Unset: the account's no-reply email.
FACTORY_GIT_EMAIL=
# Chat notices
SLACK_WEBHOOK_URL=
